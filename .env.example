# Copy to .env (git-ignored) and fill in. See README.md#keys for how to get each value.
# Read by Docker as an --env-file: plain KEY=value lines, no quotes, no inline comments.
DISCORD_TOKEN=
YOUTUBE_API_KEY=
CACHE_LIMIT=2GB
# Turns off Prisma CLI's anonymous usage pings to checkpoint.prisma.io (runs on every start)
CHECKPOINT_DISABLE=1

############
# Optional #
############
# Don't set DATA_DIR when running in Docker: the image uses /data, which scripts/start-bot.ps1 mounts from ./data.

# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# PLAYING_MESSAGE_UPDATE_INTERVAL_SECONDS=5
# ENABLE_SPONSORBLOCK=true
# SPONSORBLOCK_TIMEOUT=5
# YT_DLP_AUTO_UPDATE=true
# YT_DLP_COOKIES_PATH=/run/secrets/youtube-cookies.txt
# BOT_STATUS=
# BOT_ACTIVITY_TYPE=
# BOT_ACTIVITY_URL=
# BOT_ACTIVITY=
